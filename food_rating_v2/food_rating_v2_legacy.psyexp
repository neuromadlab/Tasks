    <Routine name="slider_horizontal">
      <RoutineSettingsComponent name="slider_horizontal" plugin="None">
        <Param val="none" valType="str" updates="None" name="backgroundFit"/>
        <Param val="" valType="str" updates="None" name="backgroundImg"/>
        <Param val="$[0,0,0]" valType="color" updates="None" name="color"/>
        <Param val="rgb" valType="str" updates="None" name="colorSpace"/>
        <Param val="" valType="str" updates="constant" name="desc"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="" valType="code" updates="None" name="durationEstim"/>
        <Param val="False" valType="code" updates="None" name="forceNonSlip"/>
        <Param val="slider_horizontal" valType="code" updates="None" name="name"/>
        <Param val="True" valType="bool" updates="None" name="saveStartStop"/>
        <Param val="" valType="code" updates="constant" name="skipIf"/>
        <Param val="duration (s)" valType="str" updates="None" name="stopType"/>
        <Param val="" valType="code" updates="constant" name="stopVal"/>
        <Param val="False" valType="bool" updates="None" name="useWindowParams"/>
      </RoutineSettingsComponent>
      <CodeComponent name="code_sliderHorizontal" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="submitbutton_opacity = opacity1&amp;#10;&amp;#10;# dimension/position for image&amp;#10;imgH_h = 0.35   # = img_h * 1.2 if mobile_device?&amp;#10;imgH_w = imgH_h*1.494; # depending on image height and aspect ratio&amp;#10;imgH_center_x = 0&amp;#10;imgH_center_y = 0.1  # 0.15 if mobile_device?&amp;#10;&amp;#10;# dimension/position for reminder text&amp;#10;reminderH_text_x = 0&amp;#10;reminderH_text_y = 0.4&amp;#10;&amp;#10;# dimension/position for slider Text&amp;#10;slidertextH_center_x = 0&amp;#10;slidertextH_center_y = -0.13 # -0.12 if mobile_device&amp;#10;&amp;#10;# dimension/position for slider&amp;#10;sliderH_wanting_w = 0.8&amp;#10;sliderH_w = sliderH_wanting_w*max(1,xrange)&amp;#10;sliderH_h = 0.045&amp;#10;sliderH_center_x = 0&amp;#10;sliderH_center_y = -0.3 # -0.25 if mobile_device&amp;#10;&amp;#10;# dimension/position for anchors&amp;#10;sliderH_label1_pos = [0,0]&amp;#10;sliderH_label2_pos = [0,0]&amp;#10;sliderH_label1_pos[0] = sliderH_center_x - (sliderH_wanting_w / 2)*max(1,xrange)&amp;#10;sliderH_label1_pos[1] = sliderH_center_y - (sliderH_h)*min(1,xrange) - 0.01&amp;#10;sliderH_label2_pos[0] = sliderH_center_x + (sliderH_wanting_w / 2)*max(1,xrange)&amp;#10;sliderH_label2_pos[1] = sliderH_center_y - (sliderH_h)*min(1,xrange) - 0.01&amp;#10;sliderH_label1_pos[0] = sliderH_label1_pos[0] *0.9&amp;#10;sliderH_label2_pos[0] = sliderH_label2_pos[0] *0.9&amp;#10;&amp;#10;if mobile_device:&amp;#10;    imgH_h = imgH_h*1.2&amp;#10;    imgH_center_y = 0.15&amp;#10;    slidertextH_center_y = -0.12&amp;#10;    sliderH_center_y = -0.25" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="submitbutton_opacity = opacity1;&amp;#10;imgH_h = 0.35;&amp;#10;imgH_w = (imgH_h * 1.494);&amp;#10;imgH_center_x = 0;&amp;#10;imgH_center_y = 0.1;&amp;#10;reminderH_text_x = 0;&amp;#10;reminderH_text_y = 0.4;&amp;#10;slidertextH_center_x = 0;&amp;#10;slidertextH_center_y = (- 0.13);&amp;#10;sliderH_wanting_w = 0.8;&amp;#10;sliderH_w = (sliderH_wanting_w * Math.max(1, xrange));&amp;#10;sliderH_h = 0.045;&amp;#10;sliderH_center_x = 0;&amp;#10;sliderH_center_y = (- 0.3);&amp;#10;sliderH_label1_pos = [0, 0];&amp;#10;sliderH_label2_pos = [0, 0];&amp;#10;sliderH_label1_pos[0] = (sliderH_center_x - ((sliderH_wanting_w / 2) * Math.max(1, xrange)));&amp;#10;sliderH_label1_pos[1] = ((sliderH_center_y - (sliderH_h * Math.min(1, xrange))) - 0.01);&amp;#10;sliderH_label2_pos[0] = (sliderH_center_x + ((sliderH_wanting_w / 2) * Math.max(1, xrange)));&amp;#10;sliderH_label2_pos[1] = ((sliderH_center_y - (sliderH_h * Math.min(1, xrange))) - 0.01);&amp;#10;sliderH_label1_pos[0] = (sliderH_label1_pos[0] * 0.9);&amp;#10;sliderH_label2_pos[0] = (sliderH_label2_pos[0] * 0.9);&amp;#10;if (mobile_device) {&amp;#10;    imgH_h = (imgH_h * 1.2);&amp;#10;    imgH_center_y = 0.15;&amp;#10;    slidertextH_center_y = (- 0.12);&amp;#10;    sliderH_center_y = (- 0.25);&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="myStart = globalClock.getTime();&amp;#10;psychoJS.experiment.addData(&quot;sliderStarted&quot;, myStart);&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="# to compute some reaction time later on&amp;#10;myStart = globalClock.getTime()&amp;#10;&amp;#10;thisExp.addData(&quot;sliderStarted&quot;, myStart)" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="# Hovereffect for submitbutton&amp;#10;if not mobile_device:&amp;#10;    if textbox_submitbuttonH.contains(mouseH):&amp;#10;        submitbutton_opacity = opacity2&amp;#10;    else:&amp;#10;        submitbutton_opacity = opacity1&amp;#10;&amp;#10;# update dimension/position for slider&amp;#10;window_height = win.size[1]&amp;#10;window_width = win.size[0]&amp;#10;xrange = (window_width / window_height)&amp;#10;sliderH_w = sliderH_wanting_w*max(1,xrange)&amp;#10;sliderH_h = 0.045&amp;#10;&amp;#10;# update position for anchors&amp;#10;sliderH_label1_pos[0] = sliderH_center_x - (sliderH_wanting_w / 2)*max(1,xrange)&amp;#10;sliderH_label1_pos[1] = sliderH_center_y - (sliderH_h)*min(1,xrange) - 0.01&amp;#10;sliderH_label2_pos[0] = sliderH_center_x + (sliderH_wanting_w / 2)*max(1,xrange)&amp;#10;sliderH_label2_pos[1] = sliderH_center_y - (sliderH_h)*min(1,xrange) - 0.01&amp;#10;sliderH_label1_pos[0] = sliderH_label1_pos[0] *0.9&amp;#10;sliderH_label2_pos[0] = sliderH_label2_pos[0] *0.9" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="if ((! mobile_device)) {&amp;#10;    if (textbox_submitbuttonH.contains(mouseH)) {&amp;#10;        submitbutton_opacity = opacity2;&amp;#10;    } else {&amp;#10;        submitbutton_opacity = opacity1;&amp;#10;    }&amp;#10;}&amp;#10;window_height = psychoJS.window.size[1];&amp;#10;window_width = psychoJS.window.size[0];&amp;#10;xrange = (window_width / window_height);&amp;#10;sliderH_w = (sliderH_wanting_w * Math.max(1, xrange));&amp;#10;sliderH_h = 0.045;&amp;#10;sliderH_label1_pos[0] = (sliderH_center_x - ((sliderH_wanting_w / 2) * Math.max(1, xrange)));&amp;#10;sliderH_label1_pos[1] = ((sliderH_center_y - (sliderH_h * Math.min(1, xrange))) - 0.01);&amp;#10;sliderH_label2_pos[0] = (sliderH_center_x + ((sliderH_wanting_w / 2) * Math.max(1, xrange)));&amp;#10;sliderH_label2_pos[1] = ((sliderH_center_y - (sliderH_h * Math.min(1, xrange))) - 0.01);&amp;#10;sliderH_label1_pos[0] = (sliderH_label1_pos[0] * 0.9);&amp;#10;sliderH_label2_pos[0] = (sliderH_label2_pos[0] * 0.9);&amp;#10;" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="cond = image_conditions[ili][condi];&amp;#10;rating = slider_H.getRating();&amp;#10;image_conditions[ili][condi] = [cond, rating];&amp;#10;psychoJS.experiment.addData(&quot;sliderStopped&quot;, globalClock.getTime());&amp;#10;psychoJS.experiment.addData(&quot;sliderRating&quot;, rating);&amp;#10;psychoJS.experiment.addData(&quot;ratingRT&quot;, slider_H.getRT());&amp;#10;myEnd = globalClock.getTime();&amp;#10;myDur = (myEnd - myStart);&amp;#10;psychoJS.experiment.addData(&quot;confirmRT&quot;, myDur);&amp;#10;psychoJS.experiment.addData(&quot;confirm&quot;, 1);&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="cond = image_conditions[ili][condi] # get the current condition&amp;#10;rating = slider_H.getRating() # get the rating for this condition&amp;#10;&amp;#10;# replace the condition with a condition-rating tuppel&amp;#10;image_conditions[ili][condi] = [cond, rating]&amp;#10;&amp;#10;# save data for both sliders under common var-names&amp;#10;thisExp.addData(&quot;sliderStopped&quot;, globalClock.getTime())&amp;#10;thisExp.addData(&quot;sliderRating&quot;, rating)&amp;#10;thisExp.addData(&quot;ratingRT&quot;, slider_H.getRT())&amp;#10;&amp;#10;# save the time of confirmation relative to routine-start&amp;#10;myEnd = globalClock.getTime()&amp;#10;myDur = myEnd - myStart&amp;#10;thisExp.addData('confirmRT', myDur)&amp;#10;thisExp.addData('confirm', 1)" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="code_sliderHorizontal" valType="code" updates="None" name="name"/>
      </CodeComponent>
      <CodeComponent name="code_ratingDetectionH" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="# ATTENTION - the javascript-part is unique!&amp;#10;# don't auto-translate from python to javascript (Auto-&gt;JS)!&amp;#10;&amp;#10;# track if ratings have been given to all sliders&amp;#10;ratingGiven = False " valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="ratingGiven = false;&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Both" valType="str" updates="None" name="Code Type"/>
        <Param val="# ATTENTION - the javascript-part is unique!&amp;#10;# don't auto-translate from python to javascript (Auto-&gt;JS)!&amp;#10;# Psychopy can't translate Pythons &quot;None&quot; to JS &quot;undefined&quot;&amp;#10;&amp;#10;# submitbutton display condition&amp;#10;ratingDone = slider_H.getRating();&amp;#10;if ratingDone != None:&amp;#10;    ratingGiven = True;&amp;#10;    &amp;#10;# Check if submitbutton was pressed and end routine if true&amp;#10;if ratingGiven and polygon_submitbuttonH.contains(mouseH):&amp;#10;    buttonPressed = mouseH.getPressed()[0];&amp;#10;    if buttonPressed == 1:&amp;#10;        continueRoutine = False # native PsychoPy var, controls continuation of routine" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="ratingDone = slider_H.getRating();&amp;#10;if ((ratingDone !== undefined)) {&amp;#10;    ratingGiven = true;&amp;#10;}&amp;#10;if ((ratingGiven &amp;&amp; textbox_submitbuttonH.contains(mouseH))) {&amp;#10;    buttonPressed = mouseH.getPressed()[0];&amp;#10;    if ((buttonPressed === 1)) {&amp;#10;        continueRoutine = false;&amp;#10;    }&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="ratingGiven = false;&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="# ATTENTION - the javascript-part is unique!&amp;#10;# don't auto-translate from python to javascript (Auto-&gt;JS)!&amp;#10;&amp;#10;ratingGiven = False;" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="code_ratingDetectionH" valType="code" updates="None" name="name"/>
      </CodeComponent>
      <CodeComponent name="code_reminderH" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
