  <Flow>
    <Routine name="global_vars"/>
    <Routine name="mobile_detection"/>
    <Routine name="language_choice"/>
    <LoopInitiator loopType="TrialHandler" name="instructionReadLoop">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="[{'instr_ger': 'In der folgenden Aufgabe sehen Sie in zufaelliger Abfolge verschiedene Bilder von Essen. Danach bitten wir Sie jeweils anzugeben, wie sehr Sie das praesentierte Essen in diesem Moment gern erhalten wuerden, bzw. wie sehr Sie das gezeigte Essen moegen. und wie ökologisch nachhaltig und wie gesund Sie das Essen einschätzen. \nAlle vier Fragen werden mittels verschiedener Skalen abgefragt: Bitte nutzen Sie die grüne horizontale Skala, um anzugeben, wie ökologisch nachhaltig Sie das Essen einschätzen, die blaue horizontale Skala, um anzugeben, wie gesund Sie das Essen einschätzen, die lila horizontale Skala, um anzugeben, wie sehr Sie das Essen in diesem Moment erhalten moechten und die vertikale Skala, um anzugeben, wie sehr Sie das dargestellte Essen in diesem Moment moegen.', 'instr_eng': 'In the following task, you will see different pictures of food in random order. We then ask you to indicate how much you want to receive the food presented at that moment, how much you like the food shown at the given moment, and how environmentally sustainable and how healthy you think the food is. \\All four questions are asked using different scales: Please use the green horizontal scale to indicate how environmentally sustainable you think the food is, the blue horizontal scale to indicate how healthy you think the food is, the purple horizontal scale to indicate how much you want to receive the food at this moment and the vertical scale to indicate how much you like the food shown at this moment.', 'instr2_ger': 'Welche Skala jeweils nach einem Bild erscheint, wird zufaellig ausgewaehlt. \nBenutzen Sie den Joystick, um auf dem Slider zu navigieren und bestaetigen Sie Ihre Antworten anschließend mit dem Button A.\n\nAm Ende des Experiments werden Sie noch gebeten die vier Kategorien: &quot;Gesundheit&quot;, &quot;ökologische Nachhaltigkeit&quot;, &quot;Geschmack (wie gerne sie das Essen mögen)&quot; und &quot;Verlangen (wie gerne sie das Essen wollen)&quot; entsprechend Ihrer persönlichen Wichtung zu raten.', 'instr2_eng': 'Which scale appears after each picture is selected at random. \nUse the joystick to navigate the slider and then confirm your answers with the A button.\n\nAt the end of the experiment you will be asked to rate the four categories: ‘healthiness’, ‘environmental sustainability’, ‘liking’ and ‘wanting’ according to your personal weighting.', 'instr3_ger': 'Bitte raten Sie im folgenden die vier Kategorien: &quot;Gesundheit&quot;, &quot;ökologische Nachhaltigkeit&quot;, &quot;Geschmack&quot; und &quot;Verlangen&quot; entsprechend Ihrer persönlichen Wichtung.', 'instr3_eng': 'Please rate the four categories below: ‘healthiness’, ‘environmental sustainability’, ‘liking’ and ‘wanting’ according to your personal weighting.'}]" valType="str"/>
      <Param name="conditionsFile" updates="None" val="stimuli/instructions.xlsx" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="num"/>
      <Param name="isTrials" updates="None" val="False" valType="bool"/>
      <Param name="loopType" updates="None" val="sequential" valType="str"/>
      <Param name="nReps" updates="None" val="1" valType="num"/>
      <Param name="name" updates="None" val="instructionReadLoop" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <Routine name="load_instructions"/>
    <LoopTerminator name="instructionReadLoop"/>
