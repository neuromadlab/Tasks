        <Param val="if ((languagechoice === &quot;ger&quot;)) {&amp;#10;    end_text = &quot;Das Experiment ist nun beendet.\nVielen Dank f\u00fcr Ihre Teilnahme.&quot;;&amp;#10;    end_text2 = &quot;Bitte schliessen Sie das Experiment nicht bevor das Fenster mit der Nachricht 'Thank you for your patience.' erscheint. \nDies kann einen Moment dauern.&quot;;&amp;#10;} else {&amp;#10;    end_text = &quot;The experiment is over.\nThank you for your participation.&quot;;&amp;#10;    end_text2 = &quot;Please do not close the experiment before the window with the message 'Thank you for your patience.' appears. \nThis may take a moment.&quot;;&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
