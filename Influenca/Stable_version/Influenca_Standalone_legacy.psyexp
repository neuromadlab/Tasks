        <Param val="//choose current images/sheets for scene setup based on your current level&amp;#10;currentNotepadImage = notepadImage_list[(level_n - 1)].toString();&amp;#10;currentScoreboardImage = scoreboardImage_list[(level_n - 1)].toString();&amp;#10;currentSyringeTypeSheetPath = syringeTypeSheet_list[(level_n - 1)].toString();" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
