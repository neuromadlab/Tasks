    <Routine name="trialOutput">
      <CodeComponent name="feedbackColors_saveData" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="if ((correctCure === &quot;left&quot;)) { //if left syringe was correct&amp;#10;    if ((correctlyDone === 1)) { //and player chose correctly&amp;#10;        leftFeedbackColor = &quot;green&quot;; //set text color of chosen side to green&amp;#10;        rightFeedbackColor = &quot;black&quot;; //right remains black&amp;#10;        score_n = Number.parseInt((score_n + leftCuredInt)); //add number of cured people to score&amp;#10;    } else { //if play chose wrong syringe&amp;#10;        leftFeedbackColor = &quot;black&quot;;&amp;#10;        rightFeedbackColor = &quot;red&quot;; //set text color of chosen side to red&amp;#10;        score_n = Number.parseInt((score_n - rightCuredInt)); //substract number of people from score&amp;#10;    }&amp;#10;} else { //vice verso for the right side&amp;#10;    if ((correctlyDone === 1)) {&amp;#10;        leftFeedbackColor = &quot;black&quot;;&amp;#10;        rightFeedbackColor = &quot;green&quot;;&amp;#10;        score_n = Number.parseInt((score_n + rightCuredInt));&amp;#10;    } else {&amp;#10;        leftFeedbackColor = &quot;red&quot;;&amp;#10;        rightFeedbackColor = &quot;black&quot;;&amp;#10;        score_n = Number.parseInt((score_n - leftCuredInt));&amp;#10;    }&amp;#10;}&amp;#10;&amp;#10;scoreBoardText = score_text + score_n.toString() + &quot;\n&quot; + round_text1 + round_n.toString() + round_text2 + &quot;\n&quot; + level_text + session_n.toString();&amp;#10;&amp;#10;round_n = (round_n + 1); //increase round number for the next round&amp;#10;&amp;#10;//automatically draw notepad images&amp;#10;//leftNotepad.setAutoDraw(true);&amp;#10;//rightNotepad.setAutoDraw(true);&amp;#10;leftSyringe_2.setAutoDraw(true);&amp;#10;rightSyringe_2.setAutoDraw(true);&amp;#10;//rewardBackgroundCircle.setAutoDraw(true);&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="if correctCure == 'leftNotepad':&amp;#10;    if correctlyDone == 1:&amp;#10;        leftFeedbackColor = 'limegreen'&amp;#10;        rightFeedbackColor = 'black'&amp;#10;        score_n = int(score_n + leftCuredInt)&amp;#10;    else: &amp;#10;        leftFeedbackColor = 'black'&amp;#10;        rightFeedbackColor = 'red'&amp;#10;        score_n = int(score_n - rightCuredInt)&amp;#10;&amp;#10;else: &amp;#10;    if correctlyDone == 1:&amp;#10;        leftFeedbackColor = 'black'&amp;#10;        rightFeedbackColor = 'limegreen'&amp;#10;        score_n = int(score_n + rightCuredInt)&amp;#10;    else: &amp;#10;        leftFeedbackColor = 'red'&amp;#10;        rightFeedbackColor = 'black'&amp;#10;        score_n = int(score_n - leftCuredInt)&amp;#10;&amp;#10;round_n = round_n + 1&amp;#10;        &amp;#10;leftNotepad.setAutoDraw(True)&amp;#10;rightNotepad.setAutoDraw(True)" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="JS" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="leftLabFeedback_2.setAutoDraw(False)&amp;#10;rightLabFeedback_2.setAutoDraw(False)&amp;#10;&amp;#10;# specify each column name and its associated variable:&amp;#10;LabTrials.addData('LeftProbability', str(leftProbability))&amp;#10;LabTrials.addData('RightProbability', str(rightProbability))&amp;#10;LabTrials.addData('LeftCured', str(leftCuredNum))&amp;#10;LabTrials.addData('RightCured', str(rightCuredNum))&amp;#10;LabTrials.addData('Level', str(level_n))&amp;#10;LabTrials.addData('Round', str(round_n))&amp;#10;LabTrials.addData('Score', str(score_n))" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="feedbackColors_saveData" valType="code" updates="None" name="name"/>
      </CodeComponent>
      <ImageComponent name="leftNotepad_2" plugin="None">
        <Param val="center" valType="str" updates="constant" name="anchor"/>
        <Param val="0.0000, 0.0000, 0.0000" valType="color" updates="constant" name="color"/>
        <Param val="rgb" valType="str" updates="constant" name="colorSpace"/>
        <Param val="1" valType="num" updates="constant" name="contrast"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="" valType="code" updates="None" name="durationEstim"/>
        <Param val="False" valType="bool" updates="constant" name="flipHoriz"/>
        <Param val="False" valType="bool" updates="constant" name="flipVert"/>
        <Param val="$currentNotepadImage" valType="file" updates="set every repeat" name="image"/>
        <Param val="linear" valType="str" updates="constant" name="interpolate"/>
        <Param val="" valType="str" updates="constant" name="mask"/>
        <Param val="leftNotepad_2" valType="code" updates="None" name="name"/>
        <Param val="" valType="num" updates="constant" name="opacity"/>
        <Param val="0" valType="num" updates="constant" name="ori"/>
        <Param val="(-.4-notepadAdjustingX, 0)" valType="list" updates="set every repeat" name="pos"/>
        <Param val="False" valType="bool" updates="None" name="saveStartStop"/>
        <Param val="(0.35*notepad_xy_ratio, 0.35)" valType="list" updates="set every repeat" name="size"/>
        <Param val="" valType="code" updates="None" name="startEstim"/>
        <Param val="time (s)" valType="str" updates="None" name="startType"/>
        <Param val="0.0" valType="code" updates="None" name="startVal"/>
        <Param val="duration (s)" valType="str" updates="None" name="stopType"/>
        <Param val="0" valType="code" updates="constant" name="stopVal"/>
        <Param val="True" valType="bool" updates="None" name="syncScreenRefresh"/>
        <Param val="128" valType="num" updates="constant" name="texture resolution"/>
        <Param val="from exp settings" valType="str" updates="None" name="units"/>
      </ImageComponent>
      <ImageComponent name="rightNotepad_2" plugin="None">
        <Param val="center" valType="str" updates="constant" name="anchor"/>
        <Param val="0.0000, 0.0000, 0.0000" valType="color" updates="constant" name="color"/>
        <Param val="rgb" valType="str" updates="constant" name="colorSpace"/>
        <Param val="1" valType="num" updates="constant" name="contrast"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="" valType="code" updates="None" name="durationEstim"/>
        <Param val="False" valType="bool" updates="constant" name="flipHoriz"/>
        <Param val="False" valType="bool" updates="constant" name="flipVert"/>
        <Param val="$currentNotepadImage" valType="file" updates="set every repeat" name="image"/>
        <Param val="linear" valType="str" updates="constant" name="interpolate"/>
        <Param val="" valType="str" updates="constant" name="mask"/>
