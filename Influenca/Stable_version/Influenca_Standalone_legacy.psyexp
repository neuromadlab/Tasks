        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="//declare empty lists for all relevant images and the variable sheets for the scene setup&amp;#10;scenes_list = [];&amp;#10;notepadImage_list = [];&amp;#10;scoreboardImage_list = [];&amp;#10;syringeTypeSheet_list = [];&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="//fill lists with all images/excel sheets&amp;#10;scenes_list.push(scenes);&amp;#10;notepadImage_list.push(notepads);&amp;#10;scoreboardImage_list.push(scoreboards);&amp;#10;syringeTypeSheet_list.push(syringeTypeSheet);" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Routine"/>
