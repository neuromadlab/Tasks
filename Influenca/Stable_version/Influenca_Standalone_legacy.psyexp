        <Param val="//set background image path for the current session&amp;#10;backgroundPath = (&quot;resources/lab_background_&quot; + session_n + &quot;.png&quot;).toString();" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="#chose a random scene:&amp;#10;&amp;#10;#random factor between 1 and 6 to decide which of the 6 scenes is shown&amp;#10;randomSceneFactor = int(random.randrange(1, 6))&amp;#10;&amp;#10;#number of chosen scene within current level&amp;#10;scene_n = str(randomSceneFactor+(level_n-1)*6)&amp;#10;&amp;#10;#set path for scene background image&amp;#10;backgroundPath = str('resources\lab_background_' + scene_n + '.png')" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="JS" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="//automatically renew scene images at the start of each routine&amp;#10;backgroundImage.setAutoDraw(true);&amp;#10;leftNotepad.setAutoDraw(true);&amp;#10;rightNotepad.setAutoDraw(true);&amp;#10;scoreboardImage.setAutoDraw(true);&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="backgroundImage.setAutoDraw(True)&amp;#10;leftNotepad.setAutoDraw(True)&amp;#10;rightNotepad.setAutoDraw(True)&amp;#10;scoreboardImage.setAutoDraw(True)&amp;#10;&amp;#10;currentTrial = 0" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="LabSceneSetupCode" valType="code" updates="None" name="name"/>
