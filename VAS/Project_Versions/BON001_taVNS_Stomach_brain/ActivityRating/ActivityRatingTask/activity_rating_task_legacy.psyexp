        <Param val="// Hovereffect for picturechoice-images&amp;#10;if (!mobile_device){&amp;#10;    if (image_picturechoice1.contains(mouse_picturechoice)) {&amp;#10;        image_picturechoice1_opacity = opacity2;&amp;#10;    } else {&amp;#10;        image_picturechoice1_opacity = opacity1;&amp;#10;    }&amp;#10;&amp;#10;    if (image_picturechoice2.contains(mouse_picturechoice)) {&amp;#10;        image_picturechoice2_opacity = opacity2;&amp;#10;    } else {&amp;#10;        image_picturechoice2_opacity = opacity1;&amp;#10;    }&amp;#10;&amp;#10;    if (image_picturechoice3.contains(mouse_picturechoice)) {&amp;#10;        image_picturechoice3_opacity = opacity2;&amp;#10;    } else {&amp;#10;        image_picturechoice3_opacity = opacity1;&amp;#10;    }&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="// Save which kind of images the participant wants &amp; choose csv stimuli file&amp;#10;if ((mouse_picturechoice.clicked_name[0] === &quot;image_picturechoice1&quot;)) {&amp;#10;    picturechoice = &quot;Male&quot;;&amp;#10;    stimuli_file_name = &quot;stimuli/stimuli_male.csv&quot;;&amp;#10;} else {&amp;#10;    if ((mouse_picturechoice.clicked_name[0] === &quot;image_picturechoice2&quot;)) {&amp;#10;        picturechoice = &quot;Female&quot;;&amp;#10;        stimuli_file_name = &quot;stimuli/stimuli_female.csv&quot;;&amp;#10;    } else {&amp;#10;        picturechoice = &quot;Both&quot;;&amp;#10;        stimuli_file_name = &quot;stimuli/stimuli_both.csv&quot;;&amp;#10;    }&amp;#10;}&amp;#10;// Store picturechoice&amp;#10;expInfo[&quot;erotic_choice&quot;] = picturechoice;&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="code_picturechoice" valType="code" updates="None" name="name"/>
