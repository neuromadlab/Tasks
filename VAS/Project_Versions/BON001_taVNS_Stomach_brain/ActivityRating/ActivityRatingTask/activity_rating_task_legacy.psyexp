      <CodeComponent name="code_enforceLandscapemode2" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="if (mobile_device){&amp;#10;    window_height = window.innerHeight;&amp;#10;    window_width = window.innerWidth;&amp;#10;    xrange = window_width/window_height;&amp;#10;&amp;#10;    if (xrange&lt;1){&amp;#10;        text_picturechoice.setOpacity(0);&amp;#10;        //image_picturechoice1.setOpacity(0);&amp;#10;        //image_picturechoice2.setOpacity(0);&amp;#10;        //image_picturechoice3.setOpacity(0);&amp;#10;        image_picturechoice1_opacity = 0;&amp;#10;        image_picturechoice2_opacity = 0;&amp;#10;        image_picturechoice3_opacity = 0;&amp;#10;        text_sourceicons.setOpacity(0);&amp;#10;&amp;#10;        text_enforceLandscape2.setOpacity(1);&amp;#10;        image_tiltphone3.setOpacity(1);&amp;#10;        text_sourceicon4.setOpacity(1);&amp;#10;    }&amp;#10;}" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="JS" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="if (mobile_device &amp;&amp; (window_height != window.innerHeight || window_width != window.innerWidth)){&amp;#10;    window_height = window.innerHeight;&amp;#10;    window_width = window.innerWidth;&amp;#10;    xrange = window_width/window_height;&amp;#10;    if (xrange&lt;1){&amp;#10;        text_picturechoice.setOpacity(0);&amp;#10;        //image_picturechoice1.setOpacity(0);&amp;#10;        //image_picturechoice2.setOpacity(0);&amp;#10;        //image_picturechoice3.setOpacity(0);&amp;#10;        image_picturechoice1_opacity = 0;&amp;#10;        image_picturechoice2_opacity = 0;&amp;#10;        image_picturechoice3_opacity = 0;&amp;#10;        text_sourceicons.setOpacity(0);&amp;#10;  &amp;#10;        text_enforceLandscape2.setOpacity(1);&amp;#10;        image_tiltphone3.setOpacity(1);&amp;#10;        text_sourceicon4.setOpacity(1);&amp;#10;    } else {&amp;#10;        text_picturechoice.setOpacity(1);&amp;#10;        //image_picturechoice1.setOpacity(1);&amp;#10;        //image_picturechoice2.setOpacity(1);&amp;#10;        //image_picturechoice3.setOpacity(1);&amp;#10;        image_picturechoice1_opacity = 1;&amp;#10;        image_picturechoice2_opacity = 1;&amp;#10;        image_picturechoice3_opacity = 1;&amp;#10;        text_sourceicons.setOpacity(1);&amp;#10;&amp;#10;        text_enforceLandscape2.setOpacity(0);&amp;#10;        image_tiltphone3.setOpacity(0);&amp;#10;        text_sourceicon4.setOpacity(0);&amp;#10;    }&amp;#10;}" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="code_enforceLandscapemode2" valType="code" updates="None" name="name"/>
      </CodeComponent>
    </Routine>
    <Routine name="instructions">
      <CodeComponent name="code_instructions" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="// Set variable size elements&amp;#10;window_height = window.innerHeight;&amp;#10;window_width = window.innerWidth;&amp;#10;xrange = window_width/window_height;&amp;#10;last_xrange = xrange;&amp;#10;yrange = window_height/window_width;&amp;#10;continuebutton_xy = [0,-0.3*Math.max(1,Math.sqrt(yrange))];" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="&amp;#10;    &amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="JS" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="// Hovereffect for continuebutton&amp;#10;if (!mobile_device){&amp;#10;    if (polygon_continuebutton.contains(mouse_instructions)) {&amp;#10;        continuebutton_opacity = opacity2;&amp;#10;    } else {&amp;#10;        continuebutton_opacity = opacity1;&amp;#10;    }&amp;#10;}&amp;#10;&amp;#10;// Set variable size elements&amp;#10;window_height = window.innerHeight;&amp;#10;window_width = window.innerWidth;&amp;#10;xrange = window_width/window_height;&amp;#10;if (xrange != last_xrange){&amp;#10;    // Size changed&amp;#10;    last_xrange = xrange;&amp;#10;    yrange = window_height/window_width;&amp;#10;    continuebutton_xy = [0,-0.3*Math.max(1,Math.sqrt(yrange))];&amp;#10;}" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
