      </SoundComponent>
      <CodeComponent name="code_playSound" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="click_counter = 0;&amp;#10;audio_duration = (sound_audiosample.getDuration() * 1000); // sec --&gt; ms&amp;#10;var d = new Date();&amp;#10;current_time = d.getTime();&amp;#10;audio_onset = ((current_time - audio_duration) + 1);&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="# Initializing variables&amp;#10;click_counter = 0&amp;#10;audio_duration = sound_audiosample.getDuration()&amp;#10;current_time = win.getFutureFlipTime(clock=None)&amp;#10;audio_onset = current_time - audio_duration + 1 # first frame-condition initially true&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Both" valType="str" updates="None" name="Code Type"/>
        <Param val="### Settings to make the Audio-Replay-Button work&amp;#10;current_time = win.getFutureFlipTime(clock=None)&amp;#10;# While audio is played and a new click comes in, let second condition become false so that audio does not play directly two times in a row&amp;#10;if current_time-audio_onset  &lt; audio_duration and len(mouse_audiosample.clicked_name) &gt; click_counter:&amp;#10;    click_counter = len(mouse_audiosample.clicked_name)&amp;#10;# Play sample every time a new click is registered and the duration of the audiosample has passed&amp;#10;if current_time-audio_onset  &gt; audio_duration and len(mouse_audiosample.clicked_name) &gt; click_counter:&amp;#10;    audio_onset = win.getFutureFlipTime(clock=None)&amp;#10;    click_counter = len(mouse_audiosample.clicked_name)&amp;#10;    sound_audiosample.play()&amp;#10;# reset button state, otherwise both mouse reponses interfere (2nd does not work)   &amp;#10;prevButtonState = [0,0,0]&amp;#10;" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="// Settings to make the Audio-Replay-Button work&amp;#10;d = new Date();&amp;#10;current_time = d.getTime();&amp;#10;// While audio is played and a new click comes in, let second condition become false so that audio does not play directly two times in a row&amp;#10;if ((((current_time-audio_onset)  &lt; audio_duration) &amp;&amp; (mouse_audiosample.clicked_name.length &gt; click_counter))) {&amp;#10;    click_counter = mouse_audiosample.clicked_name.length;&amp;#10;    }&amp;#10;// Play sample every time a new click is registered and the duration of the audiosample has passed    &amp;#10;if ((((current_time - audio_onset) &gt; audio_duration) &amp;&amp; (mouse_audiosample.clicked_name.length &gt; click_counter))) {&amp;#10;    &amp;#10;    sound_audiosample = new sound.Sound({&amp;#10;        win: psychoJS.window,&amp;#10;        value: 'stimuli/Musik_Stimuli/Music_Samples_cut_wav/Sample_01.wav',&amp;#10;        secs: (- 1),&amp;#10;    });&amp;#10;    sound_audiosample.setVolume(1.0);&amp;#10;    audio_onset = d.getTime();&amp;#10;    click_counter = mouse_audiosample.clicked_name.length;&amp;#10;    sound_audiosample.play();&amp;#10;}&amp;#10;// reset button state, otherwise both mouse reponses interfere (2nd does not work)   &amp;#10;prevButtonState = [0, 0, 0];&amp;#10;&amp;#10;// Hovereffect for replaybutton&amp;#10;if (!mobile_device){&amp;#10;    if (image_replaybutton.contains(mouse_audiosample)) {&amp;#10;        image_replaybutton_opacity = opacity2;&amp;#10;    } else {&amp;#10;        image_replaybutton_opacity = opacity1;&amp;#10;    }&amp;#10;}&amp;#10;&amp;#10;// Hovereffect for startbutton&amp;#10;if (!mobile_device){&amp;#10;    if (polygon_startbutton.contains(mouse_startExp)) {&amp;#10;        startbutton_opacity = opacity2;&amp;#10;    } else {&amp;#10;        startbutton_opacity = opacity1;&amp;#10;    }&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="code_playSound" valType="code" updates="None" name="name"/>
      </CodeComponent>
      <PolygonComponent name="polygon_startbutton" plugin="None">
        <Param val="center" valType="str" updates="constant" name="anchor"/>
        <Param val="rgb" valType="str" updates="constant" name="colorSpace"/>
        <Param val="1" valType="num" updates="constant" name="contrast"/>
