        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="### Get random order of stimuli without consecutively repeating the same item&amp;#10;# Initializing variables&amp;#10;total_stimuli = []&amp;#10;total_questions = []&amp;#10;candidate_stim = []&amp;#10;candidate_ques = []&amp;#10;stimuli_copy = []&amp;#10;question_copy = []&amp;#10;stimuli_order = []&amp;#10;question_order = []&amp;#10;n = 0&amp;#10;numTrials = N*2&amp;#10;rand_i = 0&amp;#10;# build ordered stimuli=[0,0,1,1,...,59,59] and questions=[0,1,...,0,1]&amp;#10;for i in range(N):&amp;#10;    # each stimulus appears twice&amp;#10;    total_stimuli.append(i)&amp;#10;    total_stimuli.append(i)&amp;#10;    # 0 --&gt; Wanting question; 1 --&gt; Liking question&amp;#10;    total_questions.append(0)&amp;#10;    total_questions.append(1)&amp;#10;# build permutation of stimuli and questions&amp;#10;sequence_found = False&amp;#10;while not sequence_found:&amp;#10;    stimuli_copy = total_stimuli.copy()&amp;#10;    question_copy = total_questions.copy()&amp;#10;    candidate_stim = []&amp;#10;    candidate_ques = []&amp;#10;    n = N*2&amp;#10;    # simulate random permutation of stimuli and questions&amp;#10;    for i in range(numTrials):&amp;#10;        rand_i = int(n*random())&amp;#10;        candidate_stim.append(stimuli_copy[rand_i])&amp;#10;        candidate_ques.append(question_copy[rand_i])&amp;#10;        del stimuli_copy[rand_i]&amp;#10;        del question_copy[rand_i]&amp;#10;        n -= 1&amp;#10;    sequence_found = True&amp;#10;    # stimulus shouldn't appear twice in a row&amp;#10;    for i in range(numTrials-1):&amp;#10;        if candidate_stim[i] == candidate_stim[i+1]:&amp;#10;            sequence_found = False&amp;#10;            break&amp;#10;# final stimuli and question order&amp;#10;stimuli_order = candidate_stim&amp;#10;question_order = candidate_ques" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="JS" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="code_randomizer" valType="code" updates="None" name="name"/>
      </CodeComponent>
    </Routine>
    <Routine name="trial_settings">
      <CodeComponent name="code_trialsettings" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="// Set fixation duration&amp;#10;fixation_duration = ISI + jitter[idx];&amp;#10;&amp;#10;// Define trial content&amp;#10;if ((languagechoice === &quot;ger&quot;)) {&amp;#10;    activityCol = &quot;activityGer&quot;;&amp;#10;} else {&amp;#10;    activityCol = &quot;activityUK&quot;;&amp;#10;}   &amp;#10;activity = trials.trialList[idx][activityCol];&amp;#10;activityID = trials.trialList[idx][&quot;activityID&quot;];&amp;#10;activity_text = activity;&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="JS" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="// Increment trial index&amp;#10;idx += 1;&amp;#10;&amp;#10;// Save trial data&amp;#10;expInfo['activityID'] = activityID&amp;#10;expInfo['fixation_dur'] = fixation_duration;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="code_trialsettings" valType="code" updates="None" name="name"/>
      </CodeComponent>
    </Routine>
    <Routine name="global_trial_settings">
      <CodeComponent name="code_global_trial_settings" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="### Global (static) trial settings&amp;#10;ISI = 0.1 # inter stimulus interval in s&amp;#10;# Slider settings&amp;#10;slider_wanting_center_x = 0&amp;#10;slider_wanting_center_y = -0.3&amp;#10;slider_wanting_w = 0.8&amp;#10;slider_wanting_h = 0.05&amp;#10;slider_wanting_label1_pos = [0,0] #init&amp;#10;slider_wanting_label2_pos = [0,0] #init&amp;#10;window_width = 0 #init&amp;#10;window_height = 0 #init&amp;#10;slider_liking_center_x = 0.17&amp;#10;slider_liking_center_y = 0&amp;#10;slider_liking_w = 0.03&amp;#10;slider_liking_h = 0.65&amp;#10;# Vertical (liking) slider label setting &amp;#10;# (normal labels are bugged for vertical sliders...)&amp;#10;slider_liking_ticks = (-100, -62.8, -41.6, -17.6, -6, 0, 6.2, 17.8, 44.4, 65.8, 100)&amp;#10;label_letter_height = 0.035&amp;#10;label_delta_x = 0.52 # !!! Different in js&amp;#10;label_xpos = slider_liking_center_x + label_delta_x&amp;#10;l01_ypos = slider_liking_center_y + slider_liking_h/2 * slider_liking_ticks[10]/100&amp;#10;l02_ypos = slider_liking_center_y + slider_liking_h/2 * slider_liking_ticks[9]/100&amp;#10;l03_ypos = slider_liking_center_y + slider_liking_h/2 * slider_liking_ticks[8]/100&amp;#10;l04_ypos = slider_liking_center_y + slider_liking_h/2 * slider_liking_ticks[7]/100&amp;#10;l05_ypos = slider_liking_center_y + slider_liking_h/2 * slider_liking_ticks[6]/100&amp;#10;l06_ypos = slider_liking_center_y + slider_liking_h/2 * slider_liking_ticks[5]/100&amp;#10;l07_ypos = slider_liking_center_y + slider_liking_h/2 * slider_liking_ticks[4]/100&amp;#10;l08_ypos = slider_liking_center_y + slider_liking_h/2 * slider_liking_ticks[3]/100&amp;#10;l09_ypos = slider_liking_center_y + slider_liking_h/2 * slider_liking_ticks[2]/100&amp;#10;l10_ypos = slider_liking_center_y + slider_liking_h/2 * slider_liking_ticks[1]/100&amp;#10;l11_ypos = slider_liking_center_y + slider_liking_h/2 * slider_liking_ticks[0]/100" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="ISI = 0.1;&amp;#10;opacity1 = 0.7;&amp;#10;opacity2 = 1;&amp;#10;slider_wanting_center_x = 0;&amp;#10;slider_wanting_center_y = (- 0.3);&amp;#10;slider_wanting_w = 0.8;&amp;#10;slider_wanting_h = 0.05;&amp;#10;slider_wanting_label1_pos = (0,0);&amp;#10;slider_wanting_label2_pos = (0,0);&amp;#10;window_width = 0;&amp;#10;window_height = 0;&amp;#10;slider_liking_center_x = 0.17;&amp;#10;slider_liking_center_y = 0;&amp;#10;slider_liking_w = 0.03;&amp;#10;slider_liking_h = 0.65;&amp;#10;// If opened on a mobile device the liking scala is stretched because of precision issues with the default range&amp;#10;// Also the slider is slightly more to the right such that there is more distance to the continue button&amp;#10;if( /Android|webOS|iPhone|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent) ) {&amp;#10;    slider_liking_h = 0.9;&amp;#10;    slider_liking_center_x = 0.3;&amp;#10;}&amp;#10;slider_liking_ticks = [(- 100), (- 62.8), (- 41.6), (- 17.6), (- 6), 0, 6.2, 17.8, 44.4, 65.8, 100];&amp;#10;label_letter_height = 0.035;&amp;#10;label_delta_x = 0.03;&amp;#10;label_xpos = (slider_liking_center_x + label_delta_x);&amp;#10;l01_ypos = (slider_liking_center_y + (((slider_liking_h / 2) * slider_liking_ticks[10]) / 100));&amp;#10;l02_ypos = (slider_liking_center_y + (((slider_liking_h / 2) * slider_liking_ticks[9]) / 100));&amp;#10;l03_ypos = (slider_liking_center_y + (((slider_liking_h / 2) * slider_liking_ticks[8]) / 100));&amp;#10;l04_ypos = (slider_liking_center_y + (((slider_liking_h / 2) * slider_liking_ticks[7]) / 100));&amp;#10;l05_ypos = (slider_liking_center_y + (((slider_liking_h / 2) * slider_liking_ticks[6]) / 100));&amp;#10;l06_ypos = (slider_liking_center_y + (((slider_liking_h / 2) * slider_liking_ticks[5]) / 100));&amp;#10;l07_ypos = (slider_liking_center_y + (((slider_liking_h / 2) * slider_liking_ticks[4]) / 100));&amp;#10;l08_ypos = (slider_liking_center_y + (((slider_liking_h / 2) * slider_liking_ticks[3]) / 100));&amp;#10;l09_ypos = (slider_liking_center_y + (((slider_liking_h / 2) * slider_liking_ticks[2]) / 100));&amp;#10;l10_ypos = (slider_liking_center_y + (((slider_liking_h / 2) * slider_liking_ticks[1]) / 100));&amp;#10;l11_ypos = (slider_liking_center_y + (((slider_liking_h / 2) * slider_liking_ticks[0]) / 100));&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Both" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="code_global_trial_settings" valType="code" updates="None" name="name"/>
      </CodeComponent>
    </Routine>
