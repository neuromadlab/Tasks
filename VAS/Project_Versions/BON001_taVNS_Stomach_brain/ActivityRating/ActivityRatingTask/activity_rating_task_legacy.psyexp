      </TextComponent>
      <CodeComponent name="code_slider_wanting" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="window_height = window.innerHeight;&amp;#10;window_width = window.innerWidth;&amp;#10;xrange = window_width/window_height;&amp;#10;&amp;#10;iframeReady = false&amp;#10;ratingGiven = false //track if ratings have been given to all sliders&amp;#10;&amp;#10;&amp;#10;src_vert = ('slider_vert.html?xRes='+window_width+'&amp;yRes='+window_height);&amp;#10;&amp;#10;let src = src_vert;&amp;#10;$(document).ready(function() {&amp;#10;        // Add custom contents from html file using an iframe&amp;#10;        // Embed iFrame: iframe-o top/left defines position of embedded frame relative to absolute frame (inner window of browser); iframe width/height defines frame size&amp;#10;        top = (window_height*((1/2) - (slider_liking_center_y + (slider_liking_h/2))*Math.min(1,xrange)));&amp;#10;        left = (window_width*((1/2) + (slider_liking_center_x - (slider_liking_w/2))*Math.min(1,1/xrange)));&amp;#10;        width = (slider_liking_w*window_width*Math.min(1,1/xrange));&amp;#10;        height = (slider_liking_h*window_height*Math.min(1,xrange));&amp;#10;        //$('body').append('&lt;div id=&quot;iframe-o&quot; style=&quot;visibility: hidden; position: absolute; top:'+top+'px; left:'+left+'px;&quot;&gt;&lt;iframe id=&quot;iframe&quot; src=&quot;'+src+'&quot; frameborder=&quot;0&quot; width='+width+' height='+height+'&gt;&lt;/iframe&gt;&lt;/div&gt;');&amp;#10;        $('body').append('&lt;div id=&quot;iframe-o&quot; style=&quot;visibility: hidden; position: absolute; top:'+top+'px; left:'+left+'px; width: ' + width + 'px; height: ' + height + 'px; overflow: hidden;&quot;&gt;&lt;iframe id=&quot;iframe&quot; src=&quot;' + src + '&quot; frameborder=&quot;0&quot; width=&quot;100%&quot; height=&quot;100%&quot;&gt;&lt;/iframe&gt;&lt;/div&gt;');&amp;#10;        $('#iframe').on('load',function(iframe){&amp;#10;                            &amp;#10;            //remove horizontal scrollbar&amp;#10;            $(this).contents().find('html').css({ 'display': 'table', 'width': '100%', 'overflow': 'hidden'});&amp;#10;            $('#iframe-o').css('visibility','visible');&amp;#10;            &amp;#10;            // If iframe contains sliders get their outputs.         &amp;#10;            var iframe = $('#iframe');&amp;#10;            window.iframe = iframe;//expose the iframe to the window&amp;#10;            iframeReady = true;// state that the iframe has been created&amp;#10;        });&amp;#10;});&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="JS" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="// check if rating has been given before allowing the participant to press submit&amp;#10;if (iframeReady) {&amp;#10;    if (iframe[0].contentWindow.document.getElementById(&quot;sliderscore&quot;).moved) {&amp;#10;        ratingGiven = true;&amp;#10;    }&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="// check if submit button got pressed and if so save score, remove embedding and end routine&amp;#10;if (iframeReady){&amp;#10;    if (ratingGiven &amp;&amp; t&gt;5){&amp;#10;        $('#iframe-o').remove()&amp;#10;    }    &amp;#10;}" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="code_slider_wanting" valType="code" updates="None" name="name"/>
      </CodeComponent>
    </Routine>
