        <Param val="studyID = &quot;BON006&quot;&amp;#10;sessionID = &quot;tba&quot;&amp;#10;runID = &quot;1&quot;" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="// the studyID is initiated here in order to make it available&amp;#10;// for the filename&amp;#10;const studyID = &quot;BON006&quot;;&amp;#10;" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
