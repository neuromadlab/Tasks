    <LoopInitiator loopType="TrialHandler" name="questionloop">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="[{'emaQuestions_de': 'Wie hungrig sind Sie im Moment?', 'emaQuestions_uk': 'How hungry are you at the moment?', 'emaQuestions_type': 1, 'emaQuestions_expectation': [-1]}, {'emaQuestions_de': 'Wie satt sind Sie im Moment?', 'emaQuestions_uk': 'How sated are you at the moment?', 'emaQuestions_type': 1, 'emaQuestions_expectation': [-1]}, {'emaQuestions_de': 'Wie durstig sind Sie im Moment?', 'emaQuestions_uk': 'How thirsty are you at the moment?', 'emaQuestions_type': 1, 'emaQuestions_expectation': [-1]}, {'emaQuestions_de': 'Wann haben Sie die letzte Mahlzeit gegessen?', 'emaQuestions_uk': 'When did you eat your last meal?', 'emaQuestions_type': 2, 'emaQuestions_expectation': [-1]}, {'emaQuestions_de': 'Haben Sie seit der letzten Mahlzeit noch genascht?', 'emaQuestions_uk': 'Have you had a snack since your last meal?', 'emaQuestions_type': 3, 'emaQuestions_expectation': [-1]}, {'emaQuestions_de': 'Haben Sie in den letzten 2h koffeinhaltige Getränke wie Kaffee getrunken?', 'emaQuestions_uk': 'Have you had any drinks containing caffeine, such as coffee, in the last two hours?', 'emaQuestions_type': 3, 'emaQuestions_expectation': [-1]}, {'emaQuestions_de': 'Essen Sie zurzeit deutlich mehr oder deutlich weniger im Vergleich zu Ihrem täglichen Konsum in den letzten 4 Wochen?', 'emaQuestions_uk': 'Do you currently consume significantly more or less food in comparison to the last 4 weeks? ', 'emaQuestions_type': 8, 'emaQuestions_expectation': [-1]}, {'emaQuestions_de': 'Wie wach fühlen Sie sich im Moment?', 'emaQuestions_uk': 'How awake do you feel at the moment?', 'emaQuestions_type': 1, 'emaQuestions_expectation': [-1]}, {'emaQuestions_de': 'Wie zufrieden fühlen Sie sich im Moment?', 'emaQuestions_uk': 'How happy do you feel at the moment?', 'emaQuestions_type': 1, 'emaQuestions_expectation': [-1]}, {'emaQuestions_de': 'Wie niedergeschlagen fühlen Sie sich im Moment?', 'emaQuestions_uk': 'How sad do you feel at the moment?', 'emaQuestions_type': 1, 'emaQuestions_expectation': [-1]}, {'emaQuestions_de': 'Wie gestresst fühlen Sie sich im Moment?', 'emaQuestions_uk': 'How stressed do you feel at the moment?', 'emaQuestions_type': 1, 'emaQuestions_expectation': [-1]}, {'emaQuestions_de': 'Wie stark fühlen Sie sich momentan durch Ihre Umgebung abgelenkt?', 'emaQuestions_uk': 'How strongly do you feel distracted by your current environment?', 'emaQuestions_type': 1, 'emaQuestions_expectation': [-1]}, {'emaQuestions_de': 'Wie stark fühlen Sie sich momentan durch Ihre Gedanken abgelenkt?', 'emaQuestions_uk': 'How strongly do you feel distracted by your current thoughts?', 'emaQuestions_type': 1, 'emaQuestions_expectation': [-1]}, {'emaQuestions_de': 'Wie zufrieden sind Sie gerade mit sich selbst?', 'emaQuestions_uk': 'How happy are you with yourself right now?', 'emaQuestions_type': 1, 'emaQuestions_expectation': [-1]}, {'emaQuestions_de': 'Wie ist Ihr psychisches Befinden im Moment?', 'emaQuestions_uk': 'How do you rate your mental health right now?', 'emaQuestions_type': 4, 'emaQuestions_expectation': [-1]}, {'emaQuestions_de': 'Wie ist Ihr körperliches Befinden im Moment?', 'emaQuestions_uk': 'How do you rate your physical health right now?', 'emaQuestions_type': 4, 'emaQuestions_expectation': [-1]}, {'emaQuestions_de': 'Wie motiviert fühlen Sie sich momentan?', 'emaQuestions_uk': 'How motivated do you feel right now?', 'emaQuestions_type': 1, 'emaQuestions_expectation': [-1]}, {'emaQuestions_de': 'Wenn ich angespannt bin, merke ich, wo in meinem Körper die Anspannung auftritt.', 'emaQuestions_uk': 'When I am tense I notice where the tension is located in my body.', 'emaQuestions_type': 6, 'emaQuestions_expectation': [-1]}, {'emaQuestions_de': 'Ich bin mir der Empfindungen in meinem Bauch ständig bewusst.', 'emaQuestions_uk': 'I am constantly aware of the feelings I have in my belly.', 'emaQuestions_type': 7, 'emaQuestions_expectation': [-1]}, {'emaQuestions_de': 'Wie einsam fühlen Sie sich gerade?', 'emaQuestions_uk': 'How lonely do you fell right now?', 'emaQuestions_type': 1, 'emaQuestions_expectation': [-1]}, {'emaQuestions_de': 'Hatten Sie bei Ihrer letzten Mahlzeit das Gefühl die Kontrolle über das Essen zu verlieren?', 'emaQuestions_uk': 'While you were eating, to what extent did you feel a sense of loss of control?', 'emaQuestions_type': 1, 'emaQuestions_expectation': [-1]}, {'emaQuestions_de': 'Wie groß ist Ihr Verlangen nach Essen im Moment?', 'emaQuestions_uk': 'How intense is your desire for food right now?', 'emaQuestions_type': 1, 'emaQuestions_expectation': [-1]}, {'emaQuestions_de': 'Wie sehr kreisen Ihre Gedanken ums Essen im Moment?', 'emaQuestions_uk': 'How much are your thoughts revolving around food at the moment?', 'emaQuestions_type': 1, 'emaQuestions_expectation': [-1]}, {'emaQuestions_de': 'Haben Sie heute schon Ihren Vagusnerv stimuliert?', 'emaQuestions_uk': 'Have you already stimulated your vagus nerve today?', 'emaQuestions_type': 5, 'emaQuestions_expectation': [-1]}, {'emaQuestions_de': 'Wieviele Minuten haben Sie heute moderate oder anstrengende körperliche Aktivität verrichtet?', 'emaQuestions_uk': 'How many minutes of moderate or strenuous physical activity did you do today ?', 'emaQuestions_type': 10, 'emaQuestions_expectation': [-1]}, {'emaQuestions_de': 'Haben Sie heute Schmerzmittel (Ibuprofen, Paracetamol, ASS, Novalgin etc.) eingenommen?', 'emaQuestions_uk': 'Have you taken any painkillers today (ibuprofen, paracetamol, ASS, Novalgin etc.)?', 'emaQuestions_type': 3, 'emaQuestions_expectation': [-1]}]" valType="str"/>
      <Param name="conditionsFile" updates="None" val="stimuli/emaQuestions.xlsx" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="num"/>
      <Param name="isTrials" updates="None" val="True" valType="bool"/>
      <Param name="loopType" updates="None" val="sequential" valType="str"/>
