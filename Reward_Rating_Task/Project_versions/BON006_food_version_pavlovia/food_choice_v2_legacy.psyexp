        <Param val="// text options&amp;#10;if ((languagechoice === &quot;ger&quot;)) {&amp;#10;    choiceInstructions2_text = choiceInstr2_ger;&amp;#10;} else {&amp;#10;    choiceInstructions2_text = choiceInstr2_eng;&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
